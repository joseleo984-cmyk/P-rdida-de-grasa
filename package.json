{
  "name": "perdida-de-grasa",
  "version": "1.0.0",
  "private": true,
  "description": "App web para llevar el seguimiento de procesos de pérdida de grasa.",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "test:all": "npm test && npm run test:e2e",
    "build:site": "node scripts/build-site.js",
    "legal": "node scripts/build-legal.js",
    "build:db": "node scripts/build-r1.js",
    "test:db": "node scripts/test-db.js",
    "vendor": "node scripts/vendor.js",
    "smoke:remote": "node scripts/smoke-remote.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@supabase/supabase-js": "2.117.2",
    "jsqr": "^1.4.0"
  }
}
